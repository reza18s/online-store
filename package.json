{
  "name": "nova-store",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "dev:admin": "bun run --cwd apps/admin dev",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:api:local": "powershell -NoProfile -ExecutionPolicy Bypass -File infra/docker/start-local.ps1",
    "dev:worker": "bun run --cwd apps/worker dev",
    "typecheck": "bun run --cwd packages/config typecheck && bun run --cwd packages/api-client typecheck && bun run --cwd packages/db typecheck && bun run --cwd packages/ui typecheck && bun run --cwd apps/api typecheck && bun run --cwd apps/web typecheck && bun run --cwd apps/admin typecheck && bun run --cwd apps/worker typecheck && bun run typecheck:test",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test ./apps/api/src ./apps/web/src ./apps/admin/src ./apps/worker/src ./packages/api-client/src ./packages/config/src ./packages/db/src ./packages/ui/src ./test",
    "typecheck:test": "tsc -p test/tsconfig.json --noEmit",
    "test:integration": "bun run test/integration/run.ts",
    "test:local-providers": "bun test packages/config/src/env.test.ts apps/api/src/modules/auth/auth.test.ts apps/api/src/modules/auth/otp-delivery.test.ts apps/api/src/modules/checkout/shipping.provider.test.ts apps/api/src/modules/payments/local.payment.gateway.test.ts apps/api/src/modules/payments/payments.module.test.ts apps/api/src/modules/staff-auth/staff-auth.test.ts apps/worker/src/notification-sender.test.ts",
    "test:concurrency": "bun run test/integration/live-concurrency.ts",
    "test:notification-live": "bun run test/integration/live-notification.ts",
    "test:media-live": "bun run test/integration/live-media.ts",
    "test:e2e": "bun run test/e2e/run.ts",
    "test:e2e:browser": "node node_modules/@playwright/test/cli.js test",
    "verify:local-signals": "powershell -NoProfile -ExecutionPolicy Bypass -File infra/monitoring/verify-local-signals.ps1",
    "build": "bun run --cwd packages/config build && bun run --cwd packages/api-client build && bun run --cwd packages/db build && bun run --cwd packages/ui build && bun run --cwd apps/api build && bun run --cwd apps/web build && bun run --cwd apps/admin build && bun run --cwd apps/worker build",
    "db:generate": "bun run --cwd packages/db db:generate",
    "db:migrate": "bun run --cwd packages/db db:migrate",
    "db:seed": "bun run --cwd packages/db db:seed",
    "local:staff-code": "bun tools/local-staff-code.ts",
    "docker:config": "docker compose --env-file .env.example -f infra/docker/compose.yml config"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "1.59.1",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
