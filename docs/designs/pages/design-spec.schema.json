{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nova.example/schemas/sitewide-page-design.schema.json",
  "title": "NOVA Sitewide Page Design Specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "sourceRevision",
    "direction",
    "targets",
    "frames",
    "tokens",
    "sources",
    "assets",
    "outputs",
    "qa"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "project": {
      "const": "NOVA online store"
    },
    "sourceRevision": {
      "type": "string",
      "minLength": 7
    },
    "direction": {
      "const": "Atelier Editorial / Soft Modern"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/target"
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/frame"
      }
    },
    "tokens": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/token"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/output"
      }
    },
    "qa": {
      "type": "object",
      "required": [
        "status",
        "checks"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "PASS_WITH_WARNINGS",
            "FAIL",
            "BLOCKED",
            "UNVERIFIED"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "status",
              "method",
              "evidence"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "PASS",
                  "PASS_WITH_WARNINGS",
                  "FAIL",
                  "BLOCKED",
                  "UNVERIFIED",
                  "NOT_APPLICABLE"
                ]
              },
              "method": {
                "type": "string"
              },
              "evidence": {
                "type": "string"
              },
              "affectedIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "required": [
        "id",
        "app",
        "family",
        "title",
        "routes",
        "frameIds",
        "owner",
        "sections",
        "actions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "app": {
          "enum": [
            "web",
            "admin"
          ]
        },
        "family": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "frameIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "owner": {
          "type": "string"
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assetId": {
          "type": [
            "string",
            "null"
          ]
        },
        "tabletRequired": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "frame": {
      "type": "object",
      "required": [
        "id",
        "targetId",
        "route",
        "title",
        "state",
        "viewports",
        "measurements",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "targetId": {
          "type": "string"
        },
        "route": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "state": {
          "enum": [
            "default",
            "empty",
            "loading",
            "success",
            "error",
            "warning",
            "disabled"
          ]
        },
        "viewports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/viewport"
          }
        },
        "measurements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "artifactIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "viewport": {
      "type": "object",
      "required": [
        "id",
        "width",
        "height",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "minimum": 320
        },
        "height": {
          "type": "integer",
          "minimum": 600
        },
        "status": {
          "enum": [
            "REQUIRED",
            "GENERATED",
            "VERIFIED",
            "BLOCKED",
            "NOT_APPLICABLE"
          ]
        },
        "screenshot": {
          "type": [
            "string",
            "null"
          ]
        },
        "fullPageScreenshot": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "tag",
        "rect",
        "direction",
        "fontFamily",
        "background",
        "color"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "viewportId": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "rect": {
          "type": "object",
          "required": [
            "x",
            "y",
            "width",
            "height"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "width": {
              "type": "number",
              "minimum": 0
            },
            "height": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "direction": {
          "enum": [
            "rtl",
            "ltr"
          ]
        },
        "fontFamily": {
          "type": "string"
        },
        "background": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "radius": {
          "type": "string"
        },
        "sourceStatus": {
          "enum": [
            "MEASURED",
            "SOURCE_DEFINED",
            "PROPOSED",
            "UNVERIFIED"
          ]
        }
      },
      "additionalProperties": false
    },
    "token": {
      "type": "object",
      "required": [
        "id",
        "value",
        "status",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "value": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "status": {
          "enum": [
            "SOURCE_DEFINED",
            "PROPOSED",
            "UNVERIFIED"
          ]
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "path",
        "anchor",
        "scope",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "anchor": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "required": [
        "assetId",
        "path",
        "license",
        "verification",
        "intendedUse",
        "altText"
      ],
      "properties": {
        "assetId": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "license": {
          "const": "UNKNOWN"
        },
        "verification": {
          "type": "string"
        },
        "intendedUse": {
          "type": "string"
        },
        "altText": {
          "type": "string"
        },
        "fit": {
          "type": "string"
        },
        "focalPoint": {
          "type": "string"
        },
        "width": {
          "type": [
            "integer",
            "null"
          ]
        },
        "height": {
          "type": [
            "integer",
            "null"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": [
        "id",
        "path",
        "targetId",
        "frameId",
        "viewportId",
        "artifactType",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "targetId": {
          "type": "string"
        },
        "frameId": {
          "type": "string"
        },
        "viewportId": {
          "type": "string"
        },
        "artifactType": {
          "enum": [
            "board",
            "desktop-reference",
            "mobile-reference",
            "tablet-reference",
            "render-source",
            "model",
            "schema",
            "source-index",
            "authority-map",
            "conflict-log",
            "token-registry",
            "asset-registry",
            "coverage",
            "qa-report",
            "manifest"
          ]
        },
        "status": {
          "enum": [
            "REQUIRED",
            "GENERATED",
            "VERIFIED",
            "BLOCKED",
            "NOT_APPLICABLE"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
