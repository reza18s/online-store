{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NOVA component design specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "target",
    "sourceRevision",
    "direction",
    "purpose",
    "actions",
    "states",
    "sources",
    "tokens",
    "assets",
    "frames",
    "outputs",
    "qa"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "app",
        "title",
        "owner",
        "routes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "app": {
          "enum": [
            "web",
            "admin"
          ]
        },
        "title": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "routes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "sourceRevision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "direction": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "anchor",
          "scope",
          "sha256",
          "status"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "anchor": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "DIRECT_SOURCE_READ",
              "UNVERIFIED"
            ]
          }
        }
      }
    },
    "tokens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "value",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "assetId",
          "path",
          "license",
          "width",
          "height",
          "sha256"
        ],
        "properties": {
          "assetId": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "width": {
            "type": [
              "integer",
              "null"
            ]
          },
          "height": {
            "type": [
              "integer",
              "null"
            ]
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "stateId",
          "viewports"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "stateId": {
            "type": "string"
          },
          "viewports": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "viewportId",
                "width",
                "height",
                "screenshot",
                "measurements",
                "overflowX",
                "smallTargets",
                "dir",
                "missingImages"
              ],
              "properties": {
                "viewportId": {
                  "enum": [
                    "desktop",
                    "mobile"
                  ]
                },
                "width": {
                  "type": "integer",
                  "minimum": 1
                },
                "height": {
                  "type": "integer",
                  "minimum": 1
                },
                "screenshot": {
                  "type": "string"
                },
                "measurements": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "x",
                      "y",
                      "width",
                      "height",
                      "status"
                    ],
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "parentId": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      },
                      "width": {
                        "type": "number",
                        "minimum": 0
                      },
                      "height": {
                        "type": "number",
                        "minimum": 0
                      },
                      "status": {
                        "const": "MEASURED"
                      }
                    }
                  }
                },
                "overflowX": {
                  "type": "boolean"
                },
                "smallTargets": {
                  "type": "integer",
                  "minimum": 0
                },
                "dir": {
                  "const": "rtl"
                },
                "missingImages": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "artifactType",
          "status"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "artifactType": {
            "type": "string"
          },
          "status": {
            "enum": [
              "GENERATED",
              "VERIFIED"
            ]
          }
        }
      }
    },
    "qa": {
      "type": "object",
      "required": [
        "status",
        "checks",
        "warnings"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "PASS_WITH_WARNINGS",
            "FAIL",
            "UNVERIFIED"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "status",
              "method",
              "evidence"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "PASS",
                  "PASS_WITH_WARNINGS",
                  "FAIL",
                  "BLOCKED",
                  "UNVERIFIED",
                  "NOT_APPLICABLE"
                ]
              },
              "method": {
                "type": "string"
              },
              "evidence": {
                "type": "string"
              }
            }
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
