      "children": []
    },
    {
      "id": "closed-control",
      "role": "control-state",
      "parent": "sort-control",
      "state": "closed-default",
      "source": ".category-sort select"
    },
    {
      "id": "open-picker",
      "role": "popup-state",
      "parent": "sort-control",
      "state": "open-selected",
      "source": ".category-sort select::picker(select)"
    },
    {
      "id": "selected-option",
      "role": "selected-option-state",
      "parent": "sort-control",
      "state": "open-selected",
      "source": "option:checked"
    },
    {
      "id": "unselected-options",
      "role": "hoverable-option-state",
      "parent": "sort-control",
      "state": "open-hover",
      "source": "option:not(:checked):hover"
    },
    {
      "id": "keyboard-focus-state",
      "role": "focus-state",
      "parent": "state-and-token-reference",
      "state": "keyboard-focus",
      "source": ".focus-control"
    },
    {
      "id": "selected-state",
      "role": "selected-state-sample",
      "parent": "state-and-token-reference",
      "state": "open-selected",
      "source": ".option-sample"
    },
    {
      "id": "hover-state",
      "role": "hover-state-sample",
      "parent": "state-and-token-reference",
      "state": "open-hover",
      "source": ".option-sample--hover"
    },
    {
      "id": "fallback-note",
      "role": "compatibility-note",
      "parent": "state-and-token-reference",
      "source": ".fallback-copy .fallback-badge"
    },
    {
      "id": "atelier-tokens",
