      "selected": "Current target-specific admin reference palette: warm neutral canvas, charcoal rail, oxblood active state.",
      "evidenceStatus": "SOURCE_DEFINED",
      "sourceRefs": [
        "S2"
      ],
      "rationale": "The active admin target stylesheet is more specific than older architecture-level descriptions."
    },
    {
      "property": "layout.desktop.railSide",
      "selected": "right",
      "evidenceStatus": "INFERRED",
      "sourceRefs": [
        "S1",
        "S2",
        "S11"
      ],
      "rationale": "The app and navigation are Persian RTL; the rail border marks its content-facing left edge."
    },
    {
      "property": "layout.tablet.railWidth",
      "selected": "72px",
      "evidenceStatus": "SOURCE_DEFINED",
      "sourceRefs": [
        "S3"
      ],
      "rationale": "The shared admin responsive rule already defines a 72px icon rail through 1024px."
    },
    {
      "property": "layout.phone.breakpoint",
      "selected": "max-width: 767px",
      "evidenceStatus": "SOURCE_DEFINED",
      "sourceRefs": [
        "S2",
        "S3"
      ],
      "rationale": "The target-specific reference stylesheet changes to the phone shell below 768px."
    },
    {
      "property": "layout.phone.drawerWidth",
      "selected": "min(320px, calc(100vw - 32px))",
      "evidenceStatus": "PROPOSED",
      "sourceRefs": [
        "S1",
        "S2"
      ],
      "rationale": "No staff drawer width exists; the cap keeps Persian labels readable and leaves a visible margin."
    },
    {
      "property": "interaction.phone.motion",
      "selected": "GSAP side-panel enter and exit; immediate final states for reduced motion.",
      "evidenceStatus": "PROPOSED",
      "sourceRefs": [
        "S9",
        "S10",
        "S12"
      ],
      "rationale": "Use the existing GSAP dependency version and React cleanup pattern."
    }
