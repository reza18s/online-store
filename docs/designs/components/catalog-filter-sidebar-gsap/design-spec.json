{
  "schemaVersion": "1.0.0",
  "componentId": "catalog-filter-sidebar-gsap",
  "title": "Catalog filter rail and mobile dialog",
  "locale": "fa-IR",
  "direction": "rtl",
  "owner": {
    "componentPath": "apps/web/src/features/catalog/components/listing-discovery.tsx",
    "stylePath": "apps/web/src/styles/storefront-reference.css",
    "dependencyPath": "apps/web/package.json",
    "lockPath": "bun.lock"
  },
  "purpose": "Let shoppers refine a Persian RTL product listing on desktop and mobile without losing the results context or changing filter query behavior.",
  "layout": {
    "desktop": {
      "viewportWidthPx": 1440,
      "viewportHeightPx": 900,
      "shellMaxWidthPx": 1280,
      "railMinWidthPx": 280,
      "railFraction": 0.43,
      "resultsFraction": 1,
      "columnGapPx": 18,
      "railStickyTopExpression": "calc(var(--header-height) + 14px)",
      "railMaxHeightExpression": "min(600px, calc(100vh - 325px))",
      "railSide": "right"
    },
    "mobile": {
      "breakpointMaxWidthPx": 767,
      "viewportWidthPx": 390,
      "viewportHeightPx": 844,
      "dialogWidthPx": 358,
      "dialogHeightPx": 756,
      "dialogLeftPx": 16,
      "dialogTopPx": 44,
      "dialogCornerRadiusPx": 15,
      "overlayColor": "rgb(26 18 14 / 42%)",
      "dialogAlignment": "center",
      "closeButtonTargetPx": 44,
      "resetLinkTargetHeightPx": 44
    }
  },
  "typography": {
    "storefrontStack": "Vazirmatn, Tahoma, sans-serif",
    "referenceFallbackUsed": "Tahoma, sans-serif",
    "locale": "fa-IR",
    "direction": "rtl"
  },
  "states": [
    "desktop-open",
    "desktop-closing",
    "desktop-closed",
    "mobile-open",
    "mobile-closing",
    "mobile-closed",
    "reduced-motion"
  ],
  "motion": {
    "engine": "GSAP",
    "reactIntegration": "@gsap/react useGSAP",
    "durationsStatus": "PROPOSED",
    "desktop": {
      "durationMs": 240,
      "enterEase": "power2.out",
      "exitEase": "power2.in",
      "railEnterOffsetXPx": 18,
      "railExitOffsetXPx": 18,
      "layoutBehavior": "Animate the RTL rail grid track to zero while the results track grows; hide the rail after exit completes."
    },
    "mobile": {
      "durationMs": 240,
      "ease": "power2.out",
      "dialogEnterOffsetYPx": 14,
      "dialogExitOffsetYPx": 14,
      "dialogEnterScale": 0.985,
      "overlayBehavior": "Fade the backdrop in and out with the dialog."
    },
    "reducedMotion": "Apply the final visual state immediately with no translation or scaling.",
    "lifecycle": "Keep the dialog mounted, modal focus containment active, and body scroll locked until its exit animation finishes."
  },
  "tokens": {
    "page": "#f7f4f0",
    "surface": "#fffcf9",
    "surfaceSoft": "#f1ece7",
    "ink": "#302b29",
    "muted": "#6f6560",
    "rosewood": "#7b4b59",
    "rosewoodDark": "#633d49",
    "rosewoodSoft": "#f2e8eb",
    "line": "rgb(83 61 46 / 13%)",
    "shadow": "0 10px 30px rgb(58 38 24 / 6.5%)",
    "overlay": "rgb(26 18 14 / 42%)"
  },
  "preservedBehavior": [
    "Keep the existing category, size, color, material, price, stock, and sale URL/query behavior.",
    "Keep desktop aria-expanded state and the listing-filter-rail control relationship.",
    "Keep the mobile dialog role, aria-modal semantics, Escape dismissal, focus trap, body scroll lock, and focus restoration.",
    "Keep backdrop, close, and apply actions connected to the same mobile close lifecycle.",
    "Keep the mobile dialog at the centered shape defined by the effective stylesheet.",
    "Keep reduced-motion preference usable without motion.",
    "Keep the rail on the right side of the Persian RTL desktop listing and hide it on mobile."
  ],
  "implementationContract": [
    "Use GSAP and the official @gsap/react integration for React lifecycle cleanup.",
    "Separate desired visibility from mounted presence so exit motion completes before hidden state is applied.",
    "Animate the desktop grid track and rail together; allow the results column to reclaim the available width.",
    "Animate the mobile backdrop and centered dialog together; retain modal focus and body scroll lock through exit.",
    "Use 240ms and the listed distances as proposed interaction values; keep them easy to tune.",
    "Use no image assets in the component; static reference garment shapes and counts are labeled illustrative."
  ],
  "evidence": [
    "S1",
    "S2",
