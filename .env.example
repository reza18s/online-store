# Local-only setup defaults. In development/test, empty external-provider settings
# automatically use the provider-free local OTP, payment, shipping, and notification adapters.
# Never use these values in production.
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=postgresql://nova:nova_local_only@localhost:5432/nova?schema=public
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://127.0.0.1:59000
S3_REGION=us-east-1
S3_BUCKET=nova-media-local
S3_ACCESS_KEY=nova_local_s3
S3_SECRET_KEY=nova_local_s3_secret_change_me
S3_FORCE_PATH_STYLE=true
ZARINPAL_MERCHANT_ID=
ZARINPAL_BASE_URL=
ZARINPAL_SANDBOX=true
SMS_IR_API_KEY=
SMS_IR_LINE_NUMBER=
SMS_IR_TEMPLATE_ID=
SMS_IR_BASE_URL=https://api.sms.ir/v1
SMS_IR_SANDBOX=true
IRAN_POST_API_KEY=
IRAN_POST_BASE_URL=
IRAN_POST_SANDBOX=true
AUTH_SECRET=nova-local-only-auth-secret-change-me-2026
STAFF_TOTP_ENCRYPTION_KEY=nova-local-only-staff-totp-key-change-me-2026
# Creates a synthetic admin account during `db:seed`; local/test only.
LOCAL_TEST_MODE=true
LOCAL_STAFF_EMAIL=admin@nova.local
LOCAL_STAFF_PHONE=+989120000000
LOCAL_STAFF_PASSWORD=nova-local-admin-password-2026
LOCAL_STAFF_TOTP_SECRET=JBSWY3DPEHPK3PXP
LOCAL_STAFF_RECOVERY_CODE=NOVAADMIN1
POSTGRES_DB=nova
POSTGRES_USER=nova
POSTGRES_PASSWORD=nova_local_only
POSTGRES_PORT=5432
REDIS_PORT=6379
S3_PORT=59000
S3_CONSOLE_PORT=59001
MINIO_API_STALE_UPLOADS_EXPIRY=24h
MINIO_API_STALE_UPLOADS_CLEANUP_INTERVAL=6h
