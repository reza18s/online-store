{
  "name": "nova-store",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:worker": "bun run --cwd apps/worker dev",
    "typecheck": "bun run --cwd packages/config typecheck && bun run --cwd packages/api-client typecheck && bun run --cwd packages/db typecheck && bun run --cwd packages/ui typecheck && bun run --cwd apps/api typecheck && bun run --cwd apps/web typecheck && bun run --cwd apps/worker typecheck && bun run typecheck:test",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "typecheck:test": "tsc -p test/tsconfig.json --noEmit",
    "test:integration": "bun run test/integration/run.ts",
    "test:concurrency": "bun run test/integration/live-concurrency.ts",
    "test:e2e": "bun run test/e2e/run.ts",
    "build": "bun run --cwd packages/config build && bun run --cwd packages/api-client build && bun run --cwd packages/db build && bun run --cwd packages/ui build && bun run --cwd apps/api build && bun run --cwd apps/web build && bun run --cwd apps/worker build",
    "db:generate": "bun run --cwd packages/db db:generate",
    "db:migrate": "bun run --cwd packages/db db:migrate",
    "db:seed": "bun run --cwd packages/db db:seed",
    "docker:config": "docker compose --env-file .env.example -f infra/docker/compose.yml config"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
